// `niri msg outputs`
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

 output "HDMI-A-1" {
    mode "1920x1080"
    scale 1.25 
    position x=-1536 y=0
}

output "DP-3" {
    mode "1920x1080@143.855"
    scale 1.25 
    focus-at-startup
    position x=0 y=0
}



// Built-in laptop monitor 
 output "eDP-1" {
     //mode "1920x1080"
     scale 1.25
 }
