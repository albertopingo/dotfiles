// Built-in laptop monitor 
 output "eDP-1" {
     //mode "1920x1080"
     scale 1.25
 }

 output "PNP(AOC) U27G4R XN0S1HA001367" {
     // mode "3840x2160@160.000"
    scale 2
    focus-at-startup
 }

 output "HP Inc. HP 24x 1CR9300HD0" {
    mode "1920x1080@143.855"
    scale 1.25 
 }
